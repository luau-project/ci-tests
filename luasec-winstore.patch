 #endif
 
 #include <openssl/ssl.h>
@@ -350,6 +351,85 @@ static int create(lua_State *L)
   return 1;
 }
 
+#if defined(WIN32)
+static int load_os_certs(lua_State * L)
+{
+  HCERTSTORE win_store;
+  PCCERT_CONTEXT win_ctx;
+  X509 *cert;
+  X509_STORE *cert_store;
+  const unsigned char *encoded_cert;
+  SSL_CTX *ctx = lsec_checkcontext(L, 1);
+  const char *store_name = "ROOT";
+  win_store = CertOpenSystemStoreA(
+    /* [in] HCRYPTPROV_LEGACY hProv:
+              this parameter is not used and should be set to 0 */
+    0,
+    /* [in] LPCSTR szSubsystemProtocol:
+              a string that names a system store */
+    store_name
+  );
+  if (win_store == NULL)
+  {
+    lua_pushboolean(L, 0);
+    lua_pushstring(L, "Failed to open system store.");
+    return 2;
+  }
+  cert_store = SSL_CTX_get_cert_store(ctx);
+  if (cert_store == NULL)
+  {
+    CertCloseStore(win_store, 0);
+    lua_pushboolean(L, 0);
+    lua_pushstring(L, "Failed to get certificate store for the context.");
+    return 2;
+  }
+  win_ctx = NULL; /* must be explictly set to NULL */
+  while ((win_ctx = CertFindCertificateInStore(
+    /* [in] HCERTSTORE hCertStore:
+              a handle of the certificate
+              store to be searched */
+    win_store,
+    /* [in] DWORD dwCertEncodingType:
+              the type of encoding used */
+    X509_ASN_ENCODING | PKCS_7_ASN_ENCODING,
+    /* [in] DWORD dwFindFlags:
+              used with some dwFindType values
+              to modify the search criteria */
+    0,
+    /* [in] DWORD dwFindType:
+              specifies the type of search
+              being made */
+    CERT_FIND_ANY,
+    /* [in] const void *pvFindPara:
+              points to a data item or
+              structure used with dwFindType */
+    NULL,
+    /* [in] PCCERT_CONTEXT pPrevCertContext:
+              a pointer to the last CERT_CONTEXT
+              structure returned by this function */
+    win_ctx
+  )) != NULL)
+  {
+    encoded_cert = (const unsigned char *)win_ctx->pbCertEncoded;
+    cert = d2i_X509(NULL, &encoded_cert, (long)win_ctx->cbCertEncoded);
+
+    if (cert != NULL)
+    {
+      if (X509_STORE_add_cert(cert_store, cert) != 1)
+      {
+        CertCloseStore(win_store, 0);
+        lua_pushboolean(L, 0);
+        lua_pushstring(L, "Failed to add winstore certificate to the context.");
+        return 2;
+      }
+    }
+  }
+  CertCloseStore(win_store, 0);
+  lua_pushboolean(L, 1);
+  return 1;
+}
+#endif
+
 /**
